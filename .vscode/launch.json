{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Go: Launch cmd/ (main)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Go: Debug tests in current file's package",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "cwd": "${workspaceFolder}"
    }
  ]
}
